# Environment Configuration for Hiver Support Agent

# Optional: OpenAI API Key for Live LLM-as-a-Judge
# If not provided, system automatically uses deterministic calibrated rubric judge (zero cost, offline)
OPENAI_API_KEY=

# Model configuration
LLM_MODEL=gpt-4o-mini

# Server Port Settings
BACKEND_PORT=8000
FRONTEND_PORT=5173
