# Environment Configuration for ResolveAI Support Copilot

# Google Gemini API Key for Live LLM-as-a-Judge evaluation
# Required for running LLM reply quality evaluation (python -m evaluation.run)
GEMINI_API_KEY=

# Model configuration for LLM Judge (defaults to gemini-3.7-flash)
GEMINI_MODEL=gemini-3.7-flash

# Server Port Settings
BACKEND_PORT=8000
FRONTEND_PORT=5173
