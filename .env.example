# Environment Configuration for ResolveAI Support Copilot

# OpenAI API Key for Live LLM-as-a-Judge evaluation
# Required for running LLM reply quality evaluation (python -m evaluation.run)
OPENAI_API_KEY=

# Model configuration for LLM Judge (defaults to gpt-4o-mini)
LLM_JUDGE_MODEL=gpt-4o-mini

# Server Port Settings
BACKEND_PORT=8000
FRONTEND_PORT=5173
